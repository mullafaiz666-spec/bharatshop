# Local llama.cpp runtime
LLAMA_PORT=8080
LLAMA_CTX_SIZE=8192
LLAMA_PARALLEL=2
# -1 = all supported GPU layers; use 0 for CPU-only
LLAMA_N_GPU_LAYERS=-1

# Gateway authentication. Leave empty only for localhost-only testing.
GATEWAY_API_KEY=
GATEWAY_PORT=8090

# BharatShop Render environment after exposing the gateway:
# AI_PROVIDER=local-openai-compatible
# AI_BASE_URL=https://<stable-gateway-domain>/v1
# AI_TEXT_MODEL=gemma-3-4b-it
# AI_VISION_MODEL=gemma-3-4b-it
# AI_API_KEY=<same value as GATEWAY_API_KEY, when configured>
