# BharatShop deployment/runtime configuration.
# Never commit real credentials. Keep the current production DB active until a
# Supabase copy has been validated and an explicit cutover is approved.

# ---------------------------------------------------------------------------
# App origin + automation
# ---------------------------------------------------------------------------
# Netlify automatically provides URL/DEPLOY_PRIME_URL. Set this only when you
# want a stable canonical production origin for internal scheduler calls.
BHARATSHOP_PUBLIC_ORIGIN=
NEXT_PUBLIC_SITE_URL=
BHARATSHOP_AUTOMATION_TOKEN=
# Legacy alias supported by the current automation routes.
AUTOMATION_TOKEN=

# ---------------------------------------------------------------------------
# Administrator authentication
# ---------------------------------------------------------------------------
# ADMIN_SESSION_SECRET is mandatory in production and must be at least 32 chars.
# Generate it outside source control and store it as a secret in the host.
ADMIN_SESSION_SECRET=
# Optional first-admin bootstrap via the normal login route. If set, the password
# must be at least 12 chars. Do not expose either value with NEXT_PUBLIC_.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional one-time bootstrap route secret. Leave unset unless explicitly needed.
ADMIN_BOOTSTRAP_SECRET=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Existing production connection remains the primary runtime variable.
DATABASE_URL=
# Migration-only source alias used by read-only preflight/copy verification.
# Do not configure this in the browser and do not commit a real Render URL.
SOURCE_DATABASE_URL=
# Optional Supabase Postgres connection. Used only when DATABASE_URL is absent.
# Prefer a Supabase pooler connection for serverless production workloads.
SUPABASE_DB_URL=
DB_POOL_MAX=2
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=15000
DB_MAX_USES=1000

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# Set AI_PROVIDER=gemini to use Google's Gemini REST API. Leave it unset with
# GEMINI_API_KEY absent to keep the current local OpenAI-compatible/Gemma path.
AI_PROVIDER=
GEMINI_API_KEY=
# Optional alias accepted by the provider.
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Existing local/OpenAI-compatible provider fallback.
AI_BASE_URL=
AI_API_KEY=
AI_TEXT_MODEL=
AI_VISION_MODEL=local-evidence-v1
AI_MIN_TIMEOUT_MS=
LOCAL_AI_BASE_URL=
LOCAL_AI_API_KEY=
LOCAL_AI_TEXT_MODEL=
LOCAL_AI_VISION_MODEL=
IMAGE_VERIFIER_MODE=local-evidence

# ---------------------------------------------------------------------------
# Optional PixVerse creative workstation
# ---------------------------------------------------------------------------
# PixVerse is NOT required by storefront/checkout/agents and is disabled by default.
# The official CLI uses a subscribed PixVerse account/credits and local OAuth.
# Set these only on an authorized creative workstation, never in browser variables.
PIXVERSE_ENABLED=false
PIXVERSE_ALLOW_CREDIT_SPEND=false

# ---------------------------------------------------------------------------
# Optional pinned upstream AI services / agent skills
# ---------------------------------------------------------------------------
# All upstream integrations are disabled by default and must remain server-side.
# Exact reviewed source revisions are pinned in upstreams/bharatshop-upstreams.json.
BHARATSHOP_REMOTION_ENABLED=false
REMOTION_SERVICE_URL=
REMOTION_SERVICE_TOKEN=

BHARATSHOP_OPENHANDS_ENABLED=false
OPENHANDS_AGENT_SERVER_URL=
OPENHANDS_AGENT_SERVER_TOKEN=

# PersonaLive stays blocked unless both the normal enable flag and explicit
# commercial/model-rights approval are true.
BHARATSHOP_PERSONALIVE_ENABLED=false
PERSONALIVE_SERVICE_URL=
PERSONALIVE_SERVICE_TOKEN=
PERSONALIVE_COMMERCIAL_USE_APPROVED=false

BHARATSHOP_MUMU_ENABLED=false
MUMU_AI_SERVICE_URL=
MUMU_AI_SERVICE_TOKEN=

# Dify stays isolated as a single-workspace service. Its modified Apache-2.0
# terms add multi-tenant and frontend branding conditions; review before any SaaS use.
BHARATSHOP_DIFY_ENABLED=false
DIFY_SERVICE_URL=
DIFY_SERVICE_TOKEN=

# LibreChat is an isolated MIT-licensed operator chat/agent workspace.
BHARATSHOP_LIBRECHAT_ENABLED=false
LIBRECHAT_SERVICE_URL=
LIBRECHAT_SERVICE_TOKEN=

# Set true only after `npm run skills:marketing:sync` has installed the pinned
# Corey Haines Agent Skills revision into the authorized agent workstation.
BHARATSHOP_MARKETING_SKILLS_ENABLED=false

# ---------------------------------------------------------------------------
# Optional enhancement services
# ---------------------------------------------------------------------------
# Started locally with `npm run enhancements:bootstrap`. Keep every token server-side.
BHARATSHOP_CRAWLEE_RESEARCH_ENABLED=false
RESEARCH_RUNNER_URL=
RESEARCH_RUNNER_TOKEN=

BHARATSHOP_AI_SDK_GATEWAY_ENABLED=false
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=

BHARATSHOP_UPTIME_KUMA_ENABLED=false
UPTIME_KUMA_URL=

# Trigger.dev is intentionally opt-in. No production jobs are created until a
# project and secret are explicitly configured and reviewed.
BHARATSHOP_TRIGGER_ENABLED=false
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Langfuse tracing is intentionally opt-in and may point to a self-hosted instance.
BHARATSHOP_LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Search / evidence discovery
# ---------------------------------------------------------------------------
# Optional self-hosted SearXNG endpoint. During host migration this may remain on
# a legacy service temporarily; do not mark search-ready if it is unreachable.
SEARXNG_URL=

# ---------------------------------------------------------------------------
# Supabase Auth / Storage migration inputs
# ---------------------------------------------------------------------------
# Public browser values. These do not activate Supabase Auth automatically;
# current BharatShop authentication stays active until the migration is tested.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only values. NEVER expose the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DIGITAL_BUCKET=bharatshop-digital

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Meta marketing settings
# ---------------------------------------------------------------------------
# Public settings are compiled into the browser bundle: rebuild after changes.
NEXT_PUBLIC_META_PIXEL_ID=
# Preferred explicit server-side Dataset ID. In many web setups this is the same numeric ID as the Pixel.
META_DATASET_ID=
# Legacy server-side Pixel/Dataset alias; can be omitted when META_DATASET_ID is set.
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
# Optional Page / Instagram / ad-account connection checks.
META_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_AD_ACCOUNT_ID=
META_CATALOG_ID=
META_GRAPH_API_VERSION=v26.0
# Temporary Events Manager test code; remove after testing.
META_TEST_EVENT_CODE=

# Native cutover remains locked until the guarded database copy passes parity verification.
BHARATSHOP_NATIVE_WORKER_ENABLED=false
BHARATSHOP_MIGRATION_VERIFIED=false
BHARATSHOP_NATIVE_REVISION=
BHARATSHOP_NATIVE_ORIGIN=
BHARATSHOP_NATIVE_SEARCH_URL=
